# Atlas Cloud Intelligence
ATLAS_AI_BASE_URL=https://YOUR-FOUNDRY-OR-AZURE-ENDPOINT/openai/v1
ATLAS_AI_API_KEY=replace-on-server-only
ATLAS_AI_MODEL=your-model-deployment-name
ATLAS_ENABLE_WEB_SEARCH=false
ATLAS_AI_TIMEOUT_SECONDS=45

# Development-only bearer guard. Production should use Entra/OIDC at the gateway.
ATLAS_MOBILE_SHARED_TOKEN=
